# Root-level Git ignore for the monorepo

# IDE / editor
.idea/
.vscode/
*.iml
*.ipr
*.iws

# OS files
.DS_Store
Thumbs.db

# Java / Spring
**/target/
**/build/
**/.classpath
**/.project
**/.settings/
**/.factorypath
**/.springBeans
**/.sts4-cache
**/.apt_generated
**/bin/

# Node / Angular
**/node_modules/
**/dist/
**/.angular/
**/.ng/
**/coverage/
**/tmp/
**/out-tsc/
**/*.tsbuildinfo
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Environment files
.env
.env.*

# Docker / local databases
*.local
*.sqlite
*.db

